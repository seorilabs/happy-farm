{
  "packageName": "com.seorilabs.happyfarm",
  "defaultLanguage": "ko-KR",
  "appType": "game",
  "freeOrPaid": "free",
  "contactEmail": "cs@seorilabs.com",
  "privacyPolicyUrl": "https://www.seorilabs.com/privacy",
  "targetTrack": "internal",
  "release": {
    "name": "0.1.0-internal",
    "aabPath": "apps/mobile/android/app/build/outputs/bundle/release/app-release.aab",
    "notes": {
      "ko-KR": "초기 내부 테스트 빌드입니다."
    }
  },
  "storeListing": {
    "appName": {
      "ko-KR": "행복 농장 타이쿤"
    },
    "shortDescription": {
      "ko-KR": "작물을 심고 수확하며 농장을 확장하는 방치형 농장 게임"
    },
    "fullDescription": {
      "ko-KR": "작은 밭에서 시작해 작물을 심고, 성장 시간을 기다린 뒤 수확해 골드를 모으는 농장 타이쿤 게임입니다. 골드로 밭을 넓히고 성장 속도와 판매 수익을 업그레이드하며, 조건을 채우면 새 구역을 순서대로 열 수 있습니다."
    }
  },
  "contentDeclarations": {
    "contentRating": "completed_in_play_console",
    "targetAudience": "completed_in_play_console",
    "dataSafety": "completed_in_play_console",
    "ads": "yes",
    "koreaDistribution": "yes",
    "koreaGameRating": "not_required"
  },
  "assets": {
    "playIcon": "play-store/assets/icon-512.png",
    "featureGraphic": "play-store/assets/feature-graphic-1024x500.png",
    "phoneScreenshots": [
      "play-store/screenshots/phone/phone-1.png",
      "play-store/screenshots/phone/phone-2.png"
    ],
    "sevenInchTabletScreenshots": [
      "play-store/screenshots/tablet-7/tablet-7-1.png",
      "play-store/screenshots/tablet-7/tablet-7-2.png"
    ],
    "tenInchTabletScreenshots": [
      "play-store/screenshots/tablet-10/tablet-10-1.png",
      "play-store/screenshots/tablet-10/tablet-10-2.png"
    ]
  },
  "automation": {
    "developerApiAuth": "GitHub Actions OIDC + Google Cloud Workload Identity Federation",
    "workflow": ".github/workflows/build-google-play.yml",
    "uploadScript": "scripts/upload-google-play-internal.py",
    "workloadIdentityProviderVariable": "GOOGLE_WORKLOAD_IDENTITY_PROVIDER",
    "serviceAccountEmailVariable": "GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL",
    "firstTarget": "signed AAB uploaded to internal testing as draft"
  }
}
