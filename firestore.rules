rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasOnlyCloudSaveFields() {
      return request.resource.data.keys().hasOnly([
        'schemaVersion',
        'payloadJson',
        'payloadBytes',
        'saveHash',
        'clientRevision',
        'clientUpdatedAtMs',
        'deviceId',
        'appVersion',
        'platform',
        'updatedAt'
      ]);
    }

    function isValidCloudSave() {
      return hasOnlyCloudSaveFields()
        && request.resource.data.schemaVersion == 'happy-farm-save-v1'
        && request.resource.data.payloadJson is string
        && request.resource.data.payloadJson.size() <= 900000
        && request.resource.data.payloadBytes is number
        && request.resource.data.payloadBytes > 0
        && request.resource.data.payloadBytes <= 900000
        && request.resource.data.saveHash is string
        && request.resource.data.clientRevision is number
        && request.resource.data.clientRevision > 0
        && request.resource.data.clientUpdatedAtMs is number
        && request.resource.data.clientUpdatedAtMs > 0
        && request.resource.data.deviceId is string
        && request.resource.data.appVersion is string
        && request.resource.data.platform == 'mobile'
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{userId}/saves/{saveId} {
      allow read, delete: if isSignedInOwner(userId) && saveId == 'current';
      allow create, update: if isSignedInOwner(userId) && saveId == 'current' && isValidCloudSave();
    }
  }
}
