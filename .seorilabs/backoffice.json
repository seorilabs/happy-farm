{
  "$schema": "https://raw.githubusercontent.com/seorilabs/seorilabs-backoffice/main/docs/app-ops/manifest.schema.json",
  "version": 1,
  "summary": "행복한 농장 타이쿤의 세이브 안전성, 업데이트 게이트, 광고, 경제 콘텐츠와 런타임 플래그를 운영합니다.",
  "tools": [
    {
      "id": "rewarded-ad-health",
      "section": "ads",
      "title": "보상형 광고 상태",
      "description": "실제 게임 placement별 노출·클릭·완료·실패·한도 차단 퍼널을 조회합니다.",
      "runbook": "docs/04-work/backoffice-operations.md",
      "operations": [
        {
          "id": "inspect-placement",
          "label": "placement 퍼널 조회",
          "intent": "read",
          "inputs": [
            {
              "key": "placement",
              "label": "광고 placement",
              "type": "select",
              "options": [
                { "value": "shop_gold_reward", "label": "상점 보상 골드" },
                { "value": "shop_plot_discount", "label": "상점 밭 할인" },
                { "value": "growth_ad_sheet", "label": "성장 스킵" },
                { "value": "harvest_bonus_sheet", "label": "수확 보너스" },
                { "value": "return_offline_bonus", "label": "복귀 오프라인 보너스" },
                { "value": "wheel_bonus_spin", "label": "룰렛 보너스 스핀" },
                { "value": "cooking_speed_up", "label": "요리 즉시 완성" }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "ad-controls",
      "section": "ads",
      "title": "광고 운영 제어",
      "description": "balance.json에 고정된 광고 한도와 placement별 유효 설정을 조회합니다.",
      "runbook": "docs/04-work/backoffice-operations.md",
      "operations": [
        {
          "id": "inspect",
          "label": "유효 광고 설정 조회",
          "intent": "read"
        }
      ]
    },
    {
      "id": "economy-content",
      "section": "content",
      "title": "경제·콘텐츠 상태",
      "description": "배포된 밸런스 카탈로그와 작물·구역·업그레이드·동물·공방 지표를 함께 확인합니다.",
      "runbook": "docs/04-work/backoffice-operations.md",
      "operations": [
        {
          "id": "inspect-catalog",
          "label": "밸런스 카탈로그 조회",
          "intent": "read",
          "inputs": [
            {
              "key": "content_kind",
              "label": "콘텐츠 종류",
              "type": "select",
              "options": [
                { "value": "crop", "label": "작물" },
                { "value": "area", "label": "구역" },
                { "value": "upgrade", "label": "업그레이드" },
                { "value": "animal", "label": "동물" },
                { "value": "workshop", "label": "공방" }
              ]
            }
          ]
        }
      ]
    }
  ],
  "analytics": {
    "content": {
      "market": {
        "param": "app_market",
        "platformMap": {
          "android": "google_play",
          "ios": "app_store",
          "web": "apps_in_toss"
        },
        "values": [
          { "key": "apps_in_toss", "label": "AppsInToss" },
          { "key": "google_play", "label": "Google Play" },
          { "key": "app_store", "label": "App Store" }
        ]
      },
      "metrics": [
        {
          "key": "gameStartUsers",
          "label": "게임 시작 사용자",
          "event": "game_start",
          "agg": "users"
        },
        {
          "key": "firstHarvestUsers",
          "label": "첫 의미 있는 수확",
          "event": "first_meaningful_harvest",
          "agg": "users"
        },
        {
          "key": "onboardingCompleteUsers",
          "label": "온보딩 완료 사용자",
          "event": "onboarding_complete",
          "agg": "users"
        },
        {
          "key": "onboardingSkips",
          "label": "온보딩 건너뛰기",
          "event": "onboarding_skip",
          "agg": "count"
        },
        {
          "key": "firstDailyBonusUsers",
          "label": "첫 데일리 보너스 사용자",
          "event": "first_daily_bonus_claimed",
          "agg": "users"
        },
        {
          "key": "returnShownUsers",
          "label": "복귀 요약 노출 사용자",
          "event": "return_summary_shown",
          "agg": "users"
        },
        {
          "key": "returnCollectedUsers",
          "label": "복귀 보상 수령 사용자",
          "event": "return_summary_collected",
          "agg": "users"
        },
        {
          "key": "prestigeCount",
          "label": "프레스티지",
          "event": "prestige",
          "agg": "count"
        },
        {
          "key": "upgradePurchaseCount",
          "label": "업그레이드 구매",
          "event": ["upgrade_purchased", "upgrade_batch_purchased"],
          "agg": "count"
        },
        {
          "key": "researchPurchaseCount",
          "label": "연구 구매 액션",
          "event": ["research_node_unlocked", "research_node_batch_unlocked"],
          "agg": "count"
        },
        {
          "key": "updateGateShown",
          "label": "업데이트 게이트 노출",
          "event": "update_gate_shown",
          "agg": "count"
        },
        {
          "key": "updateGateStoreClicks",
          "label": "업데이트 스토어 이동",
          "event": "update_gate_store_click",
          "agg": "count"
        }
      ],
      "derived": [
        {
          "key": "firstHarvestRate",
          "label": "첫 수확 활성화율",
          "num": "firstHarvestUsers",
          "den": "gameStartUsers",
          "unit": "%",
          "round": 1
        },
        {
          "key": "onboardingCompleteRate",
          "label": "온보딩 완료율",
          "num": "onboardingCompleteUsers",
          "den": "gameStartUsers",
          "unit": "%",
          "round": 1
        },
        {
          "key": "firstDailyBonusRate",
          "label": "첫 데일리 보너스 전환율",
          "num": "firstDailyBonusUsers",
          "den": "gameStartUsers",
          "unit": "%",
          "round": 1
        },
        {
          "key": "returnCollectRate",
          "label": "복귀 보상 수령률",
          "num": "returnCollectedUsers",
          "den": "returnShownUsers",
          "unit": "%",
          "round": 1
        },
        {
          "key": "updateGateClickRate",
          "label": "업데이트 스토어 이동률",
          "num": "updateGateStoreClicks",
          "den": "updateGateShown",
          "unit": "%",
          "round": 1
        }
      ],
      "distributions": [
        {
          "key": "researchNodes",
          "label": "연구 노드 단일 구매",
          "event": "research_node_unlocked",
          "param": "node_key",
          "topN": 12
        },
        {
          "key": "collectionRewards",
          "label": "컬렉션 보상",
          "event": "collection_reward_claimed",
          "param": "reward_key",
          "topN": 12
        },
        {
          "key": "onboardingSkippedStep",
          "label": "온보딩 건너뛴 단계",
          "event": "onboarding_skip",
          "param": "skipped_step",
          "topN": 3
        },
        {
          "key": "comboEndReason",
          "label": "수확 콤보 종료 사유",
          "event": "harvest_combo_completed",
          "param": "end_reason",
          "topN": 5
        },
        {
          "key": "adFailureReason",
          "label": "광고 실패 사유",
          "event": "ad_reward_failed",
          "param": "reason",
          "topN": 12
        },
        {
          "key": "updateGatePlatform",
          "label": "업데이트 게이트 플랫폼",
          "event": "update_gate_shown",
          "param": "platform",
          "topN": 3
        }
      ],
      "groups": [
        {
          "key": "crop",
          "label": "작물 성과",
          "param": "crop",
          "orderBy": "revenue",
          "topN": 20,
          "metrics": [
            {
              "key": "planted",
              "label": "심기",
              "event": "crop_planted",
              "agg": "count"
            },
            {
              "key": "ready",
              "label": "성장 완료",
              "event": "crop_ready_summary",
              "agg": "sum",
              "param": "ready_count"
            },
            {
              "key": "harvested",
              "label": "직접 수확",
              "event": "crop_harvested",
              "agg": "count",
              "where": [
                {
                  "param": "harvest_source",
                  "op": "ne_or_unset",
                  "value": "auto"
                }
              ]
            },
            {
              "key": "autoHarvested",
              "label": "자동 수확",
              "event": "auto_harvest_summary",
              "agg": "sum",
              "param": "harvested_count"
            },
            {
              "key": "harvesters",
              "label": "수확자",
              "event": ["crop_harvested", "auto_harvest_summary"],
              "agg": "users",
              "where": [
                {
                  "param": "harvest_source",
                  "op": "ne_or_unset",
                  "value": "auto"
                }
              ]
            },
            {
              "key": "revenue",
              "label": "직접 수확 골드",
              "event": "crop_harvested",
              "agg": "sum",
              "param": "revenue",
              "where": [
                {
                  "param": "harvest_source",
                  "op": "ne_or_unset",
                  "value": "auto"
                }
              ]
            },
            {
              "key": "autoRevenue",
              "label": "자동 수확 골드",
              "event": "auto_harvest_summary",
              "agg": "sum",
              "param": "total_gold"
            },
            {
              "key": "donations",
              "label": "직접 수확 연구 기부",
              "event": "crop_harvested",
              "agg": "count",
              "where": [
                {
                  "param": "reward_type",
                  "op": "eq",
                  "value": "research_points"
                },
                {
                  "param": "harvest_source",
                  "op": "ne_or_unset",
                  "value": "auto"
                }
              ]
            },
            {
              "key": "autoResearchPoints",
              "label": "자동 수확 연구 포인트",
              "event": "auto_harvest_summary",
              "agg": "sum",
              "param": "total_research_points"
            },
            {
              "key": "firstHarvests",
              "label": "첫 작물 수확",
              "event": "crop_harvested",
              "agg": "count",
              "where": [
                {
                  "param": "is_first_crop_harvest",
                  "op": "truthy"
                },
                {
                  "param": "harvest_source",
                  "op": "ne_or_unset",
                  "value": "auto"
                }
              ]
            }
          ],
          "derived": [
            {
              "key": "plantToHarvest",
              "label": "심기→직접 수확",
              "num": "harvested",
              "den": "planted",
              "unit": "%",
              "round": 1
            },
            {
              "key": "revenuePerHarvest",
              "label": "직접 수확당 골드",
              "num": "revenue",
              "den": "harvested",
              "scale": 1,
              "unit": "G",
              "round": 0
            }
          ]
        },
        {
          "key": "area",
          "label": "구역 언락",
          "param": "area",
          "orderBy": "unlockClicked",
          "metrics": [
            {
              "key": "unlockClicked",
              "label": "언락 클릭",
              "event": "area_unlock_clicked",
              "agg": "count"
            },
            {
              "key": "unlocked",
              "label": "언락 완료",
              "event": "area_unlocked",
              "agg": "count"
            },
            {
              "key": "unlockCost",
              "label": "언락 비용",
              "event": "area_unlocked",
              "agg": "sum",
              "param": "cost"
            },
            {
              "key": "planted",
              "label": "심기",
              "event": "crop_planted",
              "agg": "count"
            },
            {
              "key": "harvested",
              "label": "직접 수확",
              "event": "crop_harvested",
              "agg": "count",
              "where": [
                {
                  "param": "harvest_source",
                  "op": "ne_or_unset",
                  "value": "auto"
                }
              ]
            },
            {
              "key": "autoHarvested",
              "label": "자동 수확",
              "event": "auto_harvest_summary",
              "agg": "sum",
              "param": "harvested_count"
            }
          ],
          "derived": [
            {
              "key": "unlockRate",
              "label": "언락 전환율",
              "num": "unlocked",
              "den": "unlockClicked",
              "unit": "%",
              "round": 1
            }
          ]
        },
        {
          "key": "onboarding",
          "label": "온보딩 단계",
          "param": "step",
          "render": "funnel",
          "order": ["plant", "harvest", "reward"],
          "metrics": [
            {
              "key": "views",
              "label": "노출",
              "event": "onboarding_step_view",
              "agg": "count"
            },
            {
              "key": "users",
              "label": "사용자",
              "event": "onboarding_step_view",
              "agg": "users"
            },
            {
              "key": "stalls",
              "label": "정체",
              "event": "onboarding_stall",
              "agg": "count"
            }
          ]
        },
        {
          "key": "upgrade",
          "label": "업그레이드 구매",
          "param": "upgrade_kind",
          "order": ["speed", "profit"],
          "metrics": [
            {
              "key": "singlePurchases",
              "label": "단일 구매",
              "event": "upgrade_purchased",
              "agg": "count"
            },
            {
              "key": "batchPurchases",
              "label": "일괄 구매",
              "event": "upgrade_batch_purchased",
              "agg": "count"
            },
            {
              "key": "batchLevels",
              "label": "일괄 구매 레벨",
              "event": "upgrade_batch_purchased",
              "agg": "sum",
              "param": "levels_purchased"
            },
            {
              "key": "singleCost",
              "label": "단일 구매 비용",
              "event": "upgrade_purchased",
              "agg": "sum",
              "param": "cost"
            },
            {
              "key": "batchCost",
              "label": "일괄 구매 비용",
              "event": "upgrade_batch_purchased",
              "agg": "sum",
              "param": "total_cost"
            }
          ]
        },
        {
          "key": "research",
          "label": "연구 노드 구매",
          "param": "node_key",
          "orderBy": "batchLevels",
          "metrics": [
            {
              "key": "singlePurchases",
              "label": "단일 구매",
              "event": "research_node_unlocked",
              "agg": "count"
            },
            {
              "key": "batchPurchases",
              "label": "배치 구매",
              "event": "research_node_batch_unlocked",
              "agg": "count"
            },
            {
              "key": "batchLevels",
              "label": "배치 구매 레벨",
              "event": "research_node_batch_unlocked",
              "agg": "sum",
              "param": "levels_purchased"
            },
            {
              "key": "batchCost",
              "label": "배치 구매 RP",
              "event": "research_node_batch_unlocked",
              "agg": "sum",
              "param": "total_cost"
            }
          ]
        },
        {
          "key": "harvestCombo",
          "label": "수동 수확 콤보",
          "param": "combo_tier",
          "order": ["normal", "great", "legendary"],
          "metrics": [
            {
              "key": "completions",
              "label": "완료",
              "event": "harvest_combo_completed",
              "agg": "count"
            },
            {
              "key": "manualHarvests",
              "label": "수동 수확",
              "event": "harvest_combo_completed",
              "agg": "sum",
              "param": "manual_harvest_count"
            },
            {
              "key": "baseRevenue",
              "label": "기본 수익",
              "event": "harvest_combo_completed",
              "agg": "sum",
              "param": "base_revenue_total"
            },
            {
              "key": "averageDuration",
              "label": "평균 지속시간",
              "event": "harvest_combo_completed",
              "agg": "avg",
              "param": "duration_ms",
              "unit": "ms",
              "round": 0
            }
          ]
        },
        {
          "key": "animal",
          "label": "동물 퍼널",
          "param": "animal",
          "orderBy": "collections",
          "metrics": [
            {
              "key": "purchases",
              "label": "구매",
              "event": "animal_purchased",
              "agg": "count"
            },
            {
              "key": "feeds",
              "label": "급여",
              "event": "animal_fed",
              "agg": "count"
            },
            {
              "key": "collections",
              "label": "산출 수집",
              "event": "animal_produce_collected",
              "agg": "count"
            },
            {
              "key": "revenue",
              "label": "산출 수익",
              "event": "animal_produce_collected",
              "agg": "sum",
              "param": "final_revenue"
            },
            {
              "key": "rareCollections",
              "label": "희귀 산출",
              "event": "animal_produce_collected",
              "agg": "count",
              "where": [
                {
                  "param": "is_rare",
                  "op": "truthy"
                }
              ]
            }
          ]
        },
        {
          "key": "workshop",
          "label": "공방 가공",
          "param": "recipe",
          "orderBy": "started",
          "metrics": [
            {
              "key": "started",
              "label": "제작 시작",
              "event": "craft_started",
              "agg": "count"
            },
            {
              "key": "collected",
              "label": "제작 수집",
              "event": "craft_collected",
              "agg": "count"
            },
            {
              "key": "canceled",
              "label": "제작 취소",
              "event": "craft_canceled",
              "agg": "count"
            },
            {
              "key": "revenue",
              "label": "가공 수익",
              "event": "craft_collected",
              "agg": "sum",
              "param": "revenue"
            }
          ],
          "derived": [
            {
              "key": "collectRate",
              "label": "제작 수집률",
              "num": "collected",
              "den": "started",
              "unit": "%",
              "round": 1
            }
          ]
        },
        {
          "key": "adPlacement",
          "label": "광고 placement",
          "param": "placement",
          "order": [
            "shop_gold_reward",
            "shop_plot_discount",
            "growth_ad_sheet",
            "harvest_bonus_sheet",
            "return_offline_bonus",
            "wheel_bonus_spin",
            "cooking_speed_up"
          ],
          "metrics": [
            {
              "key": "impressions",
              "label": "노출",
              "event": "ad_reward_impression",
              "agg": "count"
            },
            {
              "key": "clicks",
              "label": "클릭",
              "event": "ad_reward_click",
              "agg": "count"
            },
            {
              "key": "completes",
              "label": "완료",
              "event": "ad_reward_completed",
              "agg": "count"
            },
            {
              "key": "fails",
              "label": "실패",
              "event": "ad_reward_failed",
              "agg": "count"
            },
            {
              "key": "notReadyFails",
              "label": "미준비 실패",
              "event": "ad_reward_failed",
              "agg": "count",
              "where": [
                {
                  "param": "reason",
                  "op": "eq",
                  "value": "not_ready"
                }
              ]
            },
            {
              "key": "blocked",
              "label": "한도 차단",
              "event": "ad_limit_blocked",
              "agg": "count"
            }
          ],
          "derived": [
            {
              "key": "clickRate",
              "label": "클릭률",
              "num": "clicks",
              "den": "impressions",
              "unit": "%",
              "round": 1
            },
            {
              "key": "completeRate",
              "label": "완료율",
              "num": "completes",
              "den": "clicks",
              "unit": "%",
              "round": 1
            },
            {
              "key": "failRate",
              "label": "실패율",
              "num": "fails",
              "den": "clicks",
              "unit": "%",
              "round": 1
            }
          ]
        }
      ]
    }
  }
}
