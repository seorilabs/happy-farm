# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Xcode 26.5+ 는 정적 라이브러리(비프레임워크) 방식일 때 Swift 팟의 ObjC 호환
# 헤더(-Swift.h)를 "Swift Compatibility Header" 하위 폴더에 생성한다. 그런데
# Firebase.h 는 이를 <FirebaseAuth/FirebaseAuth-Swift.h> 처럼 텍스트로 임포트하고,
# 이 임포트는 의존성으로 추적되지 않아 빌드타임에 파일을 만드는 어떤 방법으로도
# 병렬 컴파일 레이스를 피할 수 없다(gRPC-Core modulemap 누락도 동일 계열 문제).
# static framework 링크로 전환하면 각 팟이 .framework 모듈로 빌드되어 modulemap 과
# -Swift.h 를 모듈 레벨에서 노출하므로 두 문제를 근본적으로 해결한다.
# (Xcode 26.4 에서는 정적 라이브러리로도 동작했으나 26.5 에서 회귀함.)
linkage = (ENV['USE_FRAMEWORKS'] || 'static').to_sym
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage
$RNFirebaseAsStaticFramework = true

# use_frameworks! 아래에서는 모든 팟이 프레임워크 모듈로 빌드된다. 그런데 RN Firebase
# 팟(RNFB*)의 헤더는 <React/RCTBridgeModule.h> 등을 혼용 임포트하는데, 엄격한 clang
# 모듈 검증에서 "RCTBridgeModule must be imported from module ... before it is required"
# 로 RNFB 모듈 빌드가 깨진다. RNFB 팟만 static library(비프레임워크)로 강제하면 모듈
# 빌드를 피해 이 에러가 사라지고, Firebase 팟은 프레임워크로 남아 Swift 헤더를
# 정상 노출한다(Expo 의 forceStaticLinking 과 동일한 혼합 링키지 전략).
pre_install do |installer|
  installer.pod_targets.each do |pod|
    # RNFB 접두사 전체 매칭: database/storage/messaging 등 향후 RNFB 패키지가
    # 추가돼도 화이트리스트 누락으로 회귀하지 않도록 한다.
    next unless pod.name.start_with?('RNFB')
    # Pod::Target#build_type 은 attr_reader(@build_type) 이라 공개 setter 가 없다.
    # 캐시된 소스 오브 트루스인 @build_type 을 직접 설정해, attr_reader 경유든
    # 내부 ivar 직접 접근이든 일관되게 static library 로 확정한다(메서드만 싱글턴
    # 재정의하면 ivar 를 직접 읽는 경로와 어긋날 수 있음).
    pod.instance_variable_set(:@build_type, Pod::BuildType.static_library)
  end
end

target 'HappyFarmMobile' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
  end
end
