{
  "name": "@happy-farm/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "sh -c 'if command -v /usr/libexec/java_home >/dev/null 2>&1 && [ -z \"$JAVA_HOME\" ]; then export JAVA_HOME=$(/usr/libexec/java_home -v 17); fi; react-native run-android \"$@\"' --",
    "android:debughost": "node ../../scripts/set-mobile-android-debug-host.mjs",
    "android:debughost:8082": "node ../../scripts/set-mobile-android-debug-host.mjs localhost:8082",
    "android:debugview:on": "adb shell setprop debug.firebase.analytics.app com.seorilabs.happyfarm.debug",
    "android:debugview:off": "adb shell setprop debug.firebase.analytics.app .none.",
    "ios": "react-native run-ios",
    "lint": "pnpm --dir ../.. exec eslint apps/mobile",
    "start": "react-native start --projectRoot . --config metro.config.js",
    "start:reset": "react-native start --reset-cache --projectRoot . --config metro.config.js",
    "test": "jest",
    "test:core": "pnpm --dir ../.. check:core",
    "typecheck": "tsc --noEmit",
    "check:architecture": "pnpm --dir ../.. check:architecture",
    "check:release": "pnpm --dir ../.. check:play && pnpm --dir ../.. check:app-store",
    "build:android": "sh -c 'if command -v /usr/libexec/java_home >/dev/null 2>&1 && [ -z \"$JAVA_HOME\" ]; then export JAVA_HOME=$(/usr/libexec/java_home -v 17); fi; react-native build-android --mode=release'"
  },
  "dependencies": {
    "@notifee/react-native": "9.1.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/analytics": "25.1.0",
    "@react-native-firebase/app": "25.1.0",
    "@react-native-firebase/auth": "25.1.0",
    "@react-native-firebase/crashlytics": "25.1.0",
    "@react-native-firebase/firestore": "25.1.0",
    "@react-native-firebase/remote-config": "25.1.0",
    "@react-native/new-app-screen": "0.85.0",
    "@seorilabs/platform-sdk": "0.4.0",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "react-native-google-mobile-ads": "16.3.3",
    "react-native-iap": "14.7.9",
    "react-native-nitro-modules": "0.31.10",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-sound": "^0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.0",
    "@react-native/codegen": "0.85.0",
    "@react-native/eslint-config": "0.85.0",
    "@react-native/gradle-plugin": "0.85.0",
    "@react-native/jest-preset": "0.85.0",
    "@react-native/metro-config": "0.85.0",
    "@react-native/typescript-config": "0.85.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
