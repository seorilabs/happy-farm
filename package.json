{
  "name": "happy-farm",
  "private": true,
  "scripts": {
    "dev": "pnpm --dir apps/ait dev",
    "dev:ait": "pnpm --dir apps/ait dev",
    "dev:mobile": "pnpm --dir apps/mobile start",
    "build": "pnpm --dir apps/ait build",
    "build:ait": "pnpm --dir apps/ait build",
    "build:android": "pnpm --dir apps/mobile build:android",
    "check:core": "jest packages/farm-core --runInBand",
    "check:ait": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:mobile": "pnpm --dir apps/mobile typecheck && pnpm --dir apps/mobile test --watchAll=false && pnpm --dir apps/mobile build:android",
    "check:play": "node scripts/check-google-play-readiness.mjs",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "deploy": "pnpm --dir apps/ait deploy"
  },
  "dependencies": {
    "@apps-in-toss/framework": "^2.6.0",
    "@granite-js/native": "1.0.28",
    "@granite-js/react-native": "1.0.28",
    "@toss/tds-react-native": "^2.0.3",
    "brick-module": "0.5.1",
    "react": "19.2.3",
    "react-native": "0.84.0",
    "react-native-safe-area-context": "5.6.2"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/runtime": "7.28.4",
    "@eslint/js": "^9.17.0",
    "@granite-js/plugin-hermes": "1.0.28",
    "@granite-js/plugin-router": "1.0.28",
    "@testing-library/react-native": "13.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "babel-preset-granite": "1.0.28",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "jest": "^29.7.0",
    "prettier": "3.4.2",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0"
  },
  "dependenciesMeta": {
    "hermes-compiler": {
      "unplugged": true
    }
  }
}
