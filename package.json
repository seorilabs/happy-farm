{
  "name": "happy-farm",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "pnpm --dir apps/ait dev",
    "dev:ait": "pnpm --dir apps/ait dev",
    "dev:mobile": "pnpm --dir apps/mobile start",
    "build": "pnpm --dir apps/ait build",
    "build:ait": "pnpm --dir apps/ait build",
    "build:android": "pnpm --dir apps/mobile build:android",
    "check:core": "jest packages/farm-core --runInBand",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:ait": "pnpm check:architecture && pnpm --dir apps/ait lint && pnpm --dir apps/ait typecheck && pnpm check:core && pnpm --dir apps/ait test && pnpm check:platform-presence && pnpm --dir apps/ait build",
    "check:mobile": "pnpm check:architecture && pnpm --dir apps/mobile typecheck && pnpm --dir apps/mobile test --watchAll=false && pnpm --dir apps/mobile build:android",
    "check:play": "node scripts/check-google-play-readiness.mjs",
    "check:play:release": "node scripts/check-google-play-readiness.mjs --require-aab",
    "check:app-store": "node scripts/check-app-store-readiness.mjs",
    "check:firebase:android": "node scripts/check-firebase-android-config.mjs",
    "check:admob-analytics": "node scripts/check-admob-analytics-contract.mjs",
    "check:platform-presence": "pnpm --dir apps/ait test:presence",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:balance": "node scripts/check-balance.mjs",
    "check:backoffice": "node scripts/check-backoffice-manifest.mjs",
    "sim:balance": "node scripts/check-balance.mjs",
    "check:markets": "pnpm typecheck && pnpm check:architecture && pnpm check:core && pnpm check:i18n && pnpm check:balance && pnpm check:backoffice && pnpm check:play && pnpm check:app-store && pnpm check:firebase:android && pnpm check:admob-analytics",
    "check:markets:build": "pnpm check:markets && pnpm --dir apps/ait build && pnpm --dir apps/mobile build:android",
    "test": "pnpm check:platform-sdk-lock && pnpm check:admob-analytics && jest --passWithNoTests && pnpm check:platform-presence",
    "check:platform-sdk-lock": "node scripts/check-platform-sdk-lock.mjs && node --test scripts/check-platform-sdk-lock.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "deploy": "pnpm --dir apps/ait run deploy"
  },
  "dependencies": {
    "@apps-in-toss/framework": "^2.10.10",
    "@granite-js/native": "1.0.43",
    "@granite-js/react-native": "1.0.43",
    "@toss/tds-react-native": "^2.0.5",
    "brick-module": "0.5.2",
    "react": "19.2.3",
    "react-native": "0.84.0",
    "react-native-safe-area-context": "5.6.2"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/runtime": "7.28.4",
    "@eslint/js": "^9.17.0",
    "@granite-js/plugin-hermes": "1.0.43",
    "@granite-js/plugin-router": "1.0.43",
    "@testing-library/react-native": "13.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/react": "19.2.0",
    "@types/react-test-renderer": "19.1.0",
    "babel-preset-granite": "1.0.43",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "jest": "^29.7.0",
    "prettier": "3.4.2",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0"
  },
  "dependenciesMeta": {
    "hermes-compiler": {
      "unplugged": true
    }
  }
}
